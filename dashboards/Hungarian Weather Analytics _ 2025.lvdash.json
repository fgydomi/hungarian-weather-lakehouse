{
  "datasets": [
    {
      "name": "f53733d4",
      "displayName": "Daily Temperature - 2025",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    local_date,\r\n",
        "    avg_temperature_c\r\n",
        "FROM hungarian_weather_lakehouse.gold.daily_weather_local\r\n",
        "WHERE local_date >= DATE '2025-02-01'\r\n",
        "  AND local_date < DATE '2026-01-01'\r\n",
        "  AND is_complete_day = TRUE\r\n",
        "  AND temperature_hours_reported = expected_hours\r\n",
        "ORDER BY local_date, city;"
      ],
      "catalog": "hungarian_weather_lakehouse",
      "schema": "gold"
    },
    {
      "name": "53bf65a2",
      "displayName": "Monthly Precipitation - 2025",
      "queryLines": [
        "WITH complete_days AS (\r\n",
        "    SELECT\r\n",
        "        city,\r\n",
        "        CAST(DATE_TRUNC('MONTH', local_date) AS DATE)\r\n",
        "            AS month_start,\r\n",
        "        total_precipitation_mm\r\n",
        "\r\n",
        "    FROM hungarian_weather_lakehouse.gold.daily_weather_local\r\n",
        "\r\n",
        "    WHERE local_date >= DATE '2025-01-01'\r\n",
        "      AND local_date < DATE '2026-01-01'\r\n",
        "      AND weather_model = 'era5'\r\n",
        "      AND is_complete_day = TRUE\r\n",
        "      AND precipitation_hours_reported = expected_hours\r\n",
        "),\r\n",
        "\r\n",
        "monthly AS (\r\n",
        "    SELECT\r\n",
        "        city,\r\n",
        "        month_start,\r\n",
        "        ROUND(SUM(total_precipitation_mm), 2)\r\n",
        "            AS monthly_precipitation_mm,\r\n",
        "        COUNT(*) AS complete_days\r\n",
        "\r\n",
        "    FROM complete_days\r\n",
        "    GROUP BY city, month_start\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    city,\r\n",
        "    month_start,\r\n",
        "    monthly_precipitation_mm\r\n",
        "\r\n",
        "FROM monthly\r\n",
        "\r\n",
        "WHERE complete_days = DAY(LAST_DAY(month_start))\r\n",
        "\r\n",
        "ORDER BY month_start, city;"
      ],
      "catalog": "hungarian_weather_lakehouse",
      "schema": "gold"
    },
    {
      "name": "cc1e5182",
      "displayName": "Monthly Wind Speed - 2025",
      "queryLines": [
        "WITH monthly AS (\r\n",
        "    SELECT\r\n",
        "        city,\r\n",
        "        CAST(DATE_TRUNC('MONTH', local_date) AS DATE)\r\n",
        "            AS month_start,\r\n",
        "\r\n",
        "        ROUND(MAX(max_wind_speed_kmh), 1)\r\n",
        "            AS max_hourly_wind_kmh,\r\n",
        "\r\n",
        "        COUNT(*) AS complete_days\r\n",
        "\r\n",
        "    FROM hungarian_weather_lakehouse.gold.daily_weather_local\r\n",
        "\r\n",
        "    WHERE local_date >= DATE '2025-01-01'\r\n",
        "      AND local_date < DATE '2026-01-01'\r\n",
        "      AND weather_model = 'era5'\r\n",
        "      AND is_complete_day = TRUE\r\n",
        "      AND max_wind_speed_kmh IS NOT NULL\r\n",
        "\r\n",
        "    GROUP BY city, CAST(DATE_TRUNC('MONTH', local_date) AS DATE)\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    city,\r\n",
        "    month_start,\r\n",
        "    max_hourly_wind_kmh\r\n",
        "FROM monthly\r\n",
        "WHERE complete_days = DAY(LAST_DAY(month_start))\r\n",
        "ORDER BY month_start, city;\r\n"
      ]
    },
    {
      "name": "cd81f526",
      "displayName": "Weather Data Quality - 2025",
      "queryLines": [
        "WITH calendar AS (\r\n",
        "    SELECT\r\n",
        "        l.city_code AS city,\r\n",
        "        d.full_date AS local_date,\r\n",
        "\r\n",
        "        CAST((\r\n",
        "            unix_seconds(\r\n",
        "                make_timestamp(\r\n",
        "                    YEAR(date_add(d.full_date, 1)),\r\n",
        "                    MONTH(date_add(d.full_date, 1)),\r\n",
        "                    DAYOFMONTH(date_add(d.full_date, 1)),\r\n",
        "                    0, 0, 0, 'Europe/Budapest'\r\n",
        "                )\r\n",
        "            )\r\n",
        "            -\r\n",
        "            unix_seconds(\r\n",
        "                make_timestamp(\r\n",
        "                    YEAR(d.full_date),\r\n",
        "                    MONTH(d.full_date),\r\n",
        "                    DAYOFMONTH(d.full_date),\r\n",
        "                    0, 0, 0, 'Europe/Budapest'\r\n",
        "                )\r\n",
        "            )\r\n",
        "        ) / 3600 AS INT) AS expected_hours\r\n",
        "\r\n",
        "    FROM hungarian_weather_lakehouse.gold.dim_location l\r\n",
        "    CROSS JOIN hungarian_weather_lakehouse.gold.dim_date d\r\n",
        "\r\n",
        "    WHERE d.full_date >= DATE '2025-01-01'\r\n",
        "      AND d.full_date < DATE '2026-01-01'\r\n",
        "),\r\n",
        "\r\n",
        "coverage AS (\r\n",
        "    SELECT\r\n",
        "        c.city,\r\n",
        "        c.local_date,\r\n",
        "        c.expected_hours,\r\n",
        "        COALESCE(w.hours_reported, 0) AS hours_reported,\r\n",
        "        COALESCE(w.temperature_hours_reported, 0)\r\n",
        "            AS temperature_hours,\r\n",
        "        COALESCE(w.precipitation_hours_reported, 0)\r\n",
        "            AS precipitation_hours\r\n",
        "\r\n",
        "    FROM calendar c\r\n",
        "\r\n",
        "    LEFT JOIN hungarian_weather_lakehouse.gold.daily_weather_local w\r\n",
        "        ON c.city = w.city\r\n",
        "        AND c.local_date = w.local_date\r\n",
        "        AND w.weather_model = 'era5'\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    city,\r\n",
        "    COUNT(*) AS calendar_days,\r\n",
        "\r\n",
        "    COUNT_IF(hours_reported = expected_hours)\r\n",
        "        AS complete_days,\r\n",
        "\r\n",
        "    SUM(expected_hours) AS expected_hours,\r\n",
        "    SUM(hours_reported) AS observed_hours,\r\n",
        "\r\n",
        "    SUM(expected_hours - hours_reported)\r\n",
        "        AS missing_hours,\r\n",
        "\r\n",
        "    SUM(expected_hours - temperature_hours)\r\n",
        "        AS missing_temperature_values,\r\n",
        "\r\n",
        "    SUM(expected_hours - precipitation_hours)\r\n",
        "        AS missing_precipitation_values,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(hours_reported) / SUM(expected_hours),\r\n",
        "        2\r\n",
        "    ) AS coverage_pct\r\n",
        "\r\n",
        "FROM coverage\r\n",
        "GROUP BY city\r\n",
        "ORDER BY city;"
      ]
    }
  ],
